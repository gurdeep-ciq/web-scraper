# Local Postgres (docker-compose maps container 5432 -> host 5433)
DB_URL=postgresql+psycopg://scraper:scraper@localhost:5433/totalwine
DB_SCHEMA=totalwine

# Total Wine store to standardize pricing/availability on.
# Find a store id via the store locator; leave blank to let the spike discover one.
STORE_ID=

# Fetch behaviour
HEADLESS=true
# Comma-separated proxy URLs (leave blank until the Phase-0 spike says we need them)
# e.g. http://user:pass@host:port
PROXY_URLS=

# Politeness
REQUEST_DELAY_SECONDS=1.0
MAX_CONCURRENCY=4
